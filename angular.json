    "ui": {
      "projectType": "library",
      "root": "libs/ui",
      "sourceRoot": "libs/ui/src",
      "prefix": "pds",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "libs/ui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "libs/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "libs/ui/.storybook",
            "port": 6006,
            "zoneless": false,
            "assets": [
              {
                "glob": "**/*",
                "input": "libs/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "libs/styles/src/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "libs/styles/src"
              ]
            }
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "libs/ui/.storybook",
            "outputDir": "dist/storybook/ui",
            "zoneless": false,
            "assets": [
              {
                "glob": "**/*",
                "input": "libs/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "libs/styles/src/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "libs/styles/src"
              ]
            }
          }
        },
        "unit-test-app": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/test/ui",
            "index": "libs/ui/testing/index.html",
            "browser": "libs/ui/testing/main.ts",
            "tsConfig": "libs/ui/tsconfig.spec.json",
            "polyfills": ["zone.js"],
            "styles": [
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "libs/styles/src/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/styles/src"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "libs/assets",
                "output": "assets"
              }
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/ui/tsconfig.spec.json",
            "buildTarget": "ui:unit-test-app",
            "setupFiles": ["tools/testing/vitest-zone-patch.ts"],
            "browsers": ["chromium"],
            "headless": true,
            "browserViewport": "1440x900",
            "runnerConfig": "tools/testing/vitest.unit.config.mts",
            "coverageReporters": ["html", "text-summary", "lcovonly"]
          }
        }
      }
    },
    "plectrum": {
      "projectType": "library",
      "root": "libs/plectrum",
      "sourceRoot": "libs/plectrum/src",
      "prefix": "pds",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "libs/plectrum/ng-package.json"
          },
          "configurations": {
