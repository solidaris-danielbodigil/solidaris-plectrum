{
  "name": "@solidaris-danielbodigil/pds-styles",
  "version": "2.1.0",
  "description": "Plectrum ITCSS source — consume via stylePreprocessorOptions.includePaths",
  "repository": "https://github.com/solidaris-danielbodigil/solidaris-plectrum",
  "files": [
    "src/**/*.scss",
    "assets/fonts/**/*.woff2",
    "assets/fonts/**/OFL.txt",
    "README.md"
  ],
  "exports": {
    ".": "./src/main.scss",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
