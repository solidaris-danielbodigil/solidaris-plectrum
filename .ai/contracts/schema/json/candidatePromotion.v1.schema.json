{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceComponentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "coreComponentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "integrationPullRequestUrl": {
      "type": "string",
      "format": "uri"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "review": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "tokens": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "i18n": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "figma": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api",
        "tokens",
        "dependencies",
        "i18n",
        "accessibility",
        "figma"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sourceComponentId",
    "coreComponentId",
    "integrationPullRequestUrl",
    "sourceRevision",
    "review"
  ],
  "additionalProperties": false,
  "$id": "urn:plectrum:schema:candidatePromotion:1"
}
