{
  "schemaVersion": 1,
  "version": "1.3.0",
  "contexts": {
    "plectrum": {
      "root": "Plectrum checkout",
      "componentRoot": "libs/ui/src/lib",
      "stylesRoot": "libs/styles/src/06-components",
      "contracts": ".ai/contracts"
    },
    "consumer": {
      "root": "Application checkout",
      "componentRoot": "src/plectrum-candidates",
      "stylesRoot": "src/styles/plectrum-candidates",
      "contracts": ".plectrum",
      "rule": "Never edit node_modules or assume libs/ui exists."
    }
  },
  "commands": {
    "scaffold": {
      "context": "plectrum",
      "command": "npm run pds:component -- --name=<name> --owner=<team>",
      "summary": "Create a Core or local-demo component with metadata, story and style partial.",
      "available": true
    },
    "generate": {
      "context": "plectrum",
      "command": "npm run contracts:generate",
      "summary": "Regenerate the metadata registry, exports, index, schemas, toolkit snapshot and editor adapters.",
      "available": true
    },
    "check": {
      "context": "plectrum",
      "command": "npm run contracts:check",
      "summary": "Validate schemas, registry, process commands, generated files and metadata readiness.",
      "available": true
    },
    "docs": {
      "context": "plectrum",
      "command": "npm run docs:check",
      "summary": "Check that docs pages render metadata and shared process data instead of restating them.",
      "available": true
    },
    "test": {
      "context": "plectrum",
      "command": "npm run test:pipelines",
      "summary": "Run the pipeline tests: schemas, scaffold, candidates and adoption.",
      "available": true
    },
    "pack": {
      "context": "plectrum",
      "command": "npm run pack:smoke",
      "summary": "Pack the libraries and build an isolated consumer application against the tarballs.",
      "available": true
    },
    "consumerInit": {
      "context": "consumer",
      "command": "npx --no-install plectrum init --team <id> --application <id> --repository <url>",
      "summary": "Create .plectrum/config.json, editor adapters, MCP entries and the CI workflow.",
      "available": true
    },
    "consumerUpdate": {
      "context": "consumer",
      "command": "npx --no-install plectrum update",
      "summary": "Regenerate managed adapters after a toolkit upgrade; report edited managed files as conflicts.",
      "available": true
    },
    "consumerCatalogue": {
      "context": "consumer",
      "command": "npx --no-install plectrum catalogue [--id <component-id>]",
      "summary": "List the installed offline catalogue, or print one component contract.",
      "available": true
    },
    "consumerDoctor": {
      "context": "consumer",
      "command": "npx --no-install plectrum doctor [--live]",
      "summary": "Check package and toolkit compatibility, managed files and configured MCP endpoints.",
      "available": true
    },
    "consumerValidate": {
      "context": "consumer",
      "command": "npx --no-install plectrum validate --schema <schema> --file <relative.json>",
      "summary": "Validate a local JSON file against an installed exchange schema.",
      "available": true,
      "values": {
        "schema": [
          "metadata",
          "proposal",
          "submission",
          "candidateReview",
          "candidatePromotion",
          "candidateFigmaReturn",
          "candidate",
          "adoption"
        ]
      }
    },
    "consumerTokens": {
      "context": "consumer",
      "command": "npx --no-install plectrum tokens check [--strict]",
      "summary": "Check --pds-* usage against the installed token inventory; --strict also rejects hex and px.",
      "available": true
    },
    "consumerCheck": {
      "context": "consumer",
      "command": "npx --no-install plectrum check --profile ci",
      "summary": "Run the CI profile: compatibility, strict tokens, source scan, managed adapters and candidates.",
      "available": true
    },
    "consumerScaffold": {
      "context": "consumer",
      "command": "npx --no-install plectrum scaffold --name <slug> --proposal <application>-<slug>",
      "summary": "Create a local candidate after the central proposal record approves it.",
      "available": true
    },
    "candidateExport": {
      "context": "consumer",
      "command": "npx --no-install plectrum candidate-export --name <slug> [--output <path>]",
      "summary": "Write a local candidate JSON draft without contacting the central repository.",
      "available": true,
      "scope": "local-draft"
    },
    "candidateSubmit": {
      "context": "consumer",
      "command": "npx --no-install plectrum candidate-submit --name <slug> --proposal <application>-<slug> --preview <url> --checks <url> [--dry-run]",
      "summary": "Open or revise the reviewed central intake pull request for the committed candidate.",
      "available": true
    },
    "candidateWithdraw": {
      "context": "consumer",
      "command": "npx --no-install plectrum candidate-withdraw --id <application>-<slug> --reason <text> [--dry-run]",
      "summary": "Open a central pull request that withdraws the submission; the ID stays reserved.",
      "available": true
    },
    "adoptionReport": {
      "context": "consumer",
      "command": "npx --no-install plectrum adoption-report [--output <path>]",
      "summary": "Write a local adoption draft of installed packages and detected component usage.",
      "available": true,
      "scope": "local-draft"
    },
    "adoptionSubmit": {
      "context": "consumer",
      "command": "npx --no-install plectrum adoption-submit [--dry-run]",
      "summary": "Open a reviewed central pull request with the adoption report.",
      "available": true,
      "scope": "reviewed-pull-request"
    },
    "tokensBuild": {
      "context": "plectrum",
      "command": "npm run tokens:build",
      "summary": "Generate token SCSS and Storybook token annotations from tokens.json.",
      "available": true
    },
    "tokensAudit": {
      "context": "plectrum",
      "command": "npm run tokens:audit",
      "summary": "Compare tokens.json, the preset and 01-settings; report drift.",
      "available": true
    },
    "tokensPropose": {
      "context": "plectrum",
      "command": "npm run tokens:propose",
      "summary": "Write the code-owned token proposal for Figma (proposed.dtcg.json).",
      "available": true
    }
  },
  "checkProfiles": {
    "component": [
      "generate",
      "check",
      "docs",
      "test"
    ],
    "release": [
      "generate",
      "check",
      "docs",
      "test",
      "pack"
    ],
    "tokens": [
      "tokensBuild",
      "tokensAudit",
      "tokensPropose"
    ],
    "consumerCi": {
      "commands": [
        "consumerCheck"
      ],
      "strictTokens": true,
      "requireSourceScan": true,
      "requireInstalledPackages": true,
      "requireManagedAdapters": true,
      "requireCandidateStoriesAndEvidence": true
    }
  },
  "steps": [
    {
      "id": "install",
      "journey": "onboarding",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "package read access, or packed tarballs for an unreleased revision"
      ],
      "inputs": [
        "runtime packages",
        "toolkit package"
      ],
      "outputs": [
        "installed packages"
      ],
      "commands": []
    },
    {
      "id": "initialize",
      "journey": "onboarding",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "installed toolkit",
        "registered team and application"
      ],
      "inputs": [
        "team, application and repository IDs"
      ],
      "outputs": [
        ".plectrum/config.json",
        "editor adapters",
        "CI workflow"
      ],
      "commands": [
        "consumerInit",
        "consumerCatalogue",
        "consumerDoctor"
      ]
    },
    {
      "id": "build",
      "journey": "onboarding",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "installed packages"
      ],
      "inputs": [
        "stylesheet include path",
        "providePlectrum()",
        "installed catalogue"
      ],
      "outputs": [
        "themed screens from PrimeNG, Core components and --pds-* tokens"
      ],
      "commands": []
    },
    {
      "id": "validate",
      "journey": "onboarding",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "initialized toolkit"
      ],
      "inputs": [
        "application source and styles"
      ],
      "outputs": [
        "passing CI profile"
      ],
      "commands": [
        "consumerTokens",
        "consumerCheck"
      ]
    },
    {
      "id": "discover",
      "journey": "contribution",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "installed packages and toolkit"
      ],
      "inputs": [
        "installed contract snapshot",
        "PrimeNG catalogue",
        "Figma design"
      ],
      "outputs": [
        "gap proposal"
      ],
      "commands": []
    },
    {
      "id": "approve",
      "journey": "contribution",
      "owner": "core",
      "repository": "plectrum",
      "prerequisites": [
        "gap proposal"
      ],
      "inputs": [
        "proposal"
      ],
      "outputs": [
        "recorded decision and owner"
      ],
      "commands": []
    },
    {
      "id": "implement",
      "journey": "contribution",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "approved proposal",
        "compatible toolkit"
      ],
      "inputs": [
        "process contract"
      ],
      "outputs": [
        "local candidate",
        "stories",
        "metadata",
        "evidence"
      ],
      "commands": [
        "consumerInit",
        "consumerScaffold",
        "consumerCheck"
      ]
    },
    {
      "id": "submit",
      "journey": "contribution",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "checks passed"
      ],
      "inputs": [
        "candidate JSON",
        "source revision"
      ],
      "outputs": [
        "reviewed intake PR"
      ],
      "commands": [
        "candidateSubmit",
        "candidateWithdraw"
      ]
    },
    {
      "id": "integrate",
      "journey": "contribution",
      "owner": "core",
      "repository": "plectrum",
      "prerequisites": [
        "accepted candidate"
      ],
      "inputs": [
        "reviewed source"
      ],
      "outputs": [
        "core metadata",
        "package exports",
        "changeset"
      ],
      "commands": [
        "generate",
        "check",
        "docs",
        "test"
      ]
    },
    {
      "id": "design-return",
      "journey": "contribution",
      "owner": "designer",
      "repository": "plectrum",
      "prerequisites": [
        "accepted implementation",
        "reviewed token proposal"
      ],
      "inputs": [
        "source revision",
        "pinned token proposal revision",
        "verified proposal branch and collection"
      ],
      "outputs": [
        "token mapping and component node URL",
        "design approval and branch merge",
        "library publication",
        "validated return export"
      ],
      "commands": [
        "tokensPropose"
      ]
    },
    {
      "id": "export-design",
      "journey": "design",
      "owner": "designer",
      "repository": "plectrum",
      "prerequisites": [
        "approved design"
      ],
      "inputs": [
        "Figma revision"
      ],
      "outputs": [
        "staging export"
      ],
      "commands": []
    },
    {
      "id": "validate-design",
      "journey": "design",
      "owner": "core",
      "repository": "plectrum",
      "prerequisites": [
        "staging export"
      ],
      "inputs": [
        "complete token/theme state"
      ],
      "outputs": [
        "reviewed promotion PR",
        "changeset"
      ],
      "commands": [
        "tokensBuild",
        "tokensAudit",
        "tokensPropose"
      ]
    },
    {
      "id": "release",
      "journey": "both",
      "owner": "release",
      "repository": "plectrum",
      "prerequisites": [
        "CI passed",
        "review approved"
      ],
      "inputs": [
        "exact source revision"
      ],
      "outputs": [
        "packages",
        "contract snapshot",
        "versioned docs",
        "release manifest"
      ],
      "commands": [
        "pack"
      ]
    },
    {
      "id": "adopt",
      "journey": "both",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "published release"
      ],
      "inputs": [
        "compatible packages and toolkit"
      ],
      "outputs": [
        "validated adoption JSON"
      ],
      "commands": [
        "adoptionReport",
        "adoptionSubmit"
      ]
    },
    {
      "id": "upgrade",
      "journey": "onboarding",
      "owner": "team",
      "repository": "consumer",
      "prerequisites": [
        "published release"
      ],
      "inputs": [
        "dependency update pull request",
        "release notes"
      ],
      "outputs": [
        "upgraded packages and regenerated adapters"
      ],
      "commands": [
        "consumerUpdate",
        "consumerDoctor",
        "consumerCheck"
      ]
    },
    {
      "id": "change-in-plectrum",
      "journey": "plectrum",
      "owner": "core",
      "repository": "plectrum",
      "prerequisites": [
        "correction, or Core-owned work"
      ],
      "inputs": [
        "pull request with a changeset when published behaviour changes"
      ],
      "outputs": [
        "reviewed change on main"
      ],
      "commands": [
        "scaffold",
        "generate",
        "check",
        "docs",
        "test"
      ]
    }
  ],
  "transitions": [
    {
      "from": "proposed",
      "to": "approved",
      "role": "core",
      "evidence": [
        "proposal-review"
      ]
    },
    {
      "from": "approved",
      "to": "implemented",
      "role": "team",
      "evidence": [
        "source",
        "preview",
        "checks"
      ]
    },
    {
      "from": "implemented",
      "to": "submitted",
      "role": "team",
      "evidence": [
        "submission"
      ]
    },
    {
      "from": "submitted",
      "to": "accepted",
      "role": "core",
      "evidence": [
        "code-review",
        "design-feasibility-review"
      ]
    },
    {
      "from": "accepted",
      "to": "figma-reviewed",
      "role": "designer",
      "evidence": [
        "token-mapping",
        "component-node",
        "design-approval",
        "branch-merge",
        "figma-publication",
        "return-export"
      ]
    },
    {
      "from": "figma-reviewed",
      "to": "released",
      "role": "release",
      "evidence": [
        "release-manifest",
        "return-checks"
      ]
    },
    {
      "from": "proposed",
      "to": "rejected",
      "role": "core",
      "evidence": [
        "decision"
      ]
    },
    {
      "from": "submitted",
      "to": "rejected",
      "role": "core",
      "evidence": [
        "decision"
      ]
    },
    {
      "from": "proposed",
      "to": "withdrawn",
      "role": "team",
      "evidence": [
        "decision"
      ]
    },
    {
      "from": "approved",
      "to": "withdrawn",
      "role": "team",
      "evidence": [
        "decision"
      ]
    },
    {
      "from": "implemented",
      "to": "withdrawn",
      "role": "team",
      "evidence": [
        "decision"
      ]
    },
    {
      "from": "submitted",
      "to": "withdrawn",
      "role": "team",
      "evidence": [
        "decision"
      ]
    }
  ],
  "toolkit": {
    "invocation": "npx --no-install plectrum",
    "globalOptions": [
      "--root <path>"
    ],
    "notes": [
      "Candidate and adoption pull requests need GH_TOKEN or GITHUB_TOKEN.",
      "adoption-submit does nothing until reporting.enabled is true in .plectrum/config.json."
    ]
  },
  "journeys": {
    "onboarding": [
      "install",
      "initialize",
      "build",
      "validate",
      "adopt",
      "upgrade"
    ],
    "contribution": [
      "discover",
      "approve",
      "implement",
      "submit",
      "integrate",
      "design-return",
      "release",
      "adopt"
    ],
    "design": [
      "export-design",
      "validate-design",
      "release",
      "adopt"
    ]
  },
  "proposalOutcomes": {
    "approved-candidate": {
      "next": "team",
      "repository": "consumer",
      "step": "implement",
      "effect": "The requesting team is the recorded owner. The toolkit scaffolds and submits only under this decision."
    },
    "use-existing": {
      "next": "team",
      "repository": "consumer",
      "step": null,
      "effect": "No candidate intake. The team uses the existing PrimeNG control, Core component or token."
    },
    "app-specific": {
      "next": "team",
      "repository": "consumer",
      "step": null,
      "effect": "No central candidate intake: the toolkit refuses to scaffold or submit under this decision."
    },
    "rejected": {
      "next": "team",
      "repository": "consumer",
      "step": null,
      "effect": "No candidate intake: the toolkit refuses to scaffold or submit under this decision."
    }
  },
  "routes": [
    {
      "id": "local-candidate",
      "decision": "approved-candidate",
      "steps": [
        "implement",
        "submit"
      ]
    },
    {
      "id": "plectrum-change",
      "decision": null,
      "steps": [
        "change-in-plectrum"
      ]
    },
    {
      "id": "promotion",
      "decision": "approved-candidate",
      "steps": [
        "integrate",
        "design-return",
        "release"
      ]
    }
  ],
  "capabilities": {
    "storybookMcp": {
      "context": "plectrum",
      "endpoint": "http://localhost:6006/mcp",
      "requires": "npm run storybook",
      "toolsets": {
        "docs": [
          "docs-list",
          "docs-show",
          "docs-show-story"
        ],
        "development": [
          "get-storybook-story-instructions",
          "stories-find-by-component",
          "stories-preview"
        ],
        "testing": [
          "test-run"
        ]
      },
      "scaffolds": false,
      "gate": "npm run test-storybook",
      "note": "test-run uses the same @storybook/addon-vitest runner as the testing widget. It is local feedback, not the CI gate."
    }
  }
}
