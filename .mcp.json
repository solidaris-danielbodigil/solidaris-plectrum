{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "primeng": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@primeng/mcp@21.1.9",
        "-p",
        "@modelcontextprotocol/sdk@1.25.2",
        "primeng-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    }
  }
}
