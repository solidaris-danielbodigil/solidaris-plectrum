    "@angular/router": "21.2.16",
    "@primeuix/themes": "^2.0.3",
    "@solidaris-danielbodigil/pds-plectrum": "2.0.4",
    "@solidaris-danielbodigil/pds-styles": "2.0.4",
    "@solidaris-danielbodigil/pds-ui": "2.0.4",
