{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "submit",
        "revise",
        "withdraw"
      ]
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "application": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "revision",
        "path"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "component": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "enum": [
                "atoms",
                "molecules",
                "organisms",
                "templates"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "interactive",
                "display",
                "container",
                "input",
                "navigation",
                "feedback"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "primeNgComponent": {
              "type": "string",
              "minLength": 1
            },
            "bemBlock": {
              "type": "string",
              "minLength": 1
            },
            "itcssLayer": {
              "type": "string",
