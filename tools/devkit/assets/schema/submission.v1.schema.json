        "distribution": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "angular"
                },
                "entryPoint": {
                  "type": "string",
                  "pattern": "^(\\.|\\.\\/patterns\\/[a-z][a-z0-9-]*)$"
                },
                "exportName": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "entryPoint",
                "exportName"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "styles"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "local"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "governance": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "core",
                "candidate",
                "app",
                "deprecated"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "replacementId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
            }
          },
          "required": [
            "status",
            "owner"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "useCases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "commonPatterns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "composition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "description",
                  "composition"
                ],
                "additionalProperties": false
              }
            },
            "antiPatterns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scenario": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alternative": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "scenario",
                  "reason",
                  "alternative"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "useCases",
            "commonPatterns",
            "antiPatterns"
          ],
          "additionalProperties": false
        },
        "anatomy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "part",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "variants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "default": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "options",
              "default",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "composition": {
          "type": "object",
          "properties": {
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allowedComponents": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "name",
                  "description"
                ],
                "additionalProperties": false
              }
            },
            "parentConstraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "companions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "nestedComponents": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "behavior": {
          "type": "object",
          "properties": {
            "states": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "interactions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "responsive": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "states"
          ],
          "additionalProperties": false
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "type",
              "required",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "ariaAttributes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "keyboardSupport": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "wcagLevel": {
              "type": "string",
              "enum": [
                "A",
                "AA",
                "AAA"
              ]
            },
            "contrastRequirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence": {
              "type": "object",
              "properties": {
                "automated": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "not-assessed"
                  ]
                },
                "manualKeyboard": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed",
                        "not-assessed"
                      ]
                    },
                    "by": {
                      "type": "string",
                      "enum": [
                        "person",
                        "agent"
                      ]
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false
                },
                "manualScreenReader": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed",
                        "not-assessed"
                      ]
                    },
                    "by": {
                      "type": "string",
                      "enum": [
                        "person",
                        "agent"
                      ]
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "automated",
                "manualKeyboard",
                "manualScreenReader",
                "date",
                "version",
                "limitations"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "wcagLevel"
          ],
          "additionalProperties": false
        },
        "tokens": {
          "type": "object",
          "properties": {
            "consumed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "primeNgMappings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "consumed"
          ],
          "additionalProperties": false
        },
        "aiHints": {
          "type": "object",
          "properties": {
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "selectionCriteria": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "priority",
            "context",
            "selectionCriteria",
            "keywords"
          ],
          "additionalProperties": false
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "description",
              "code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "component",
        "distribution",
        "governance",
        "usage",
        "accessibility",
        "tokens",
        "aiHints",
        "examples"
      ],
      "additionalProperties": false
    },
    "toolkitVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "processVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "preview": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "url",
        "revision"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "url",
        "revision"
      ],
      "additionalProperties": false
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "withdrawalReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "proposalId",
    "operation",
    "componentId",
    "team",
    "application",
    "origin",
    "metadata",
    "toolkitVersion",
    "processVersion",
    "packages",
    "preview",
    "checks",
    "submittedAt"
  ],
  "additionalProperties": false,
  "$id": "urn:plectrum:schema:submission:1"
}
