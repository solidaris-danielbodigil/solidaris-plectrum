{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "registry": {
      "type": "string",
      "format": "uri"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "integrity": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version",
          "integrity"
        ],
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "url",
        "sha256",
        "schemaVersion",
        "version"
      ],
      "additionalProperties": false
    },
    "toolkit": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "toolkitVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "dsVersionRange": {
          "type": "string",
          "minLength": 1
        },
        "contractSchemaRange": {
          "type": "string",
          "minLength": 1
        },
        "processVersionRange": {
          "type": "string",
          "minLength": 1
        },
        "editors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "verified"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "toolkitVersion",
        "dsVersionRange",
        "contractSchemaRange",
        "processVersionRange",
        "editors",
        "status"
      ],
      "additionalProperties": false
    },
    "documentation": {
      "type": "string",
      "format": "uri"
    },
    "figmaReturn": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "url",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "revision",
    "publishedAt",
    "registry",
    "packages",
    "contracts",
    "toolkit",
    "documentation"
  ],
  "additionalProperties": false,
  "$id": "urn:plectrum:schema:release:1"
}
