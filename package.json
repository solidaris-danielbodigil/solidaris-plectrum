{
  "name": "solidaris-plectrum",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "libs/ui",
    "libs/plectrum",
    "libs/styles"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "start": "ng serve ishare",
    "start:icrm": "ng serve icrm",
    "start:dashboard": "ng serve dashboard",
    "build": "ng build ishare",
    "build:icrm": "ng build icrm",
    "build:dashboard": "ng build dashboard",
    "build:ui": "ng build ui",
    "build:plectrum": "ng build plectrum",
    "build:libs": "ng build plectrum && ng build ui",
    "test": "ng test",
    "test:coverage": "ng test ui --no-watch --code-coverage && ng test ishare --no-watch --code-coverage",
    "lint": "ng lint",
    "lint:styles": "stylelint \"libs/styles/src/**/*.scss\"",
    "lint:styles:test": "node --test tools/stylelint/*.spec.mjs",
    "changelog:build": "node tools/scripts/changelog-to-ts.mjs",
    "storybook": "npm run changelog:build && ng run ui:storybook",
    "build-storybook": "npm run changelog:build && ng run ui:build-storybook",
    "test-storybook": "test-storybook --config-dir libs/ui/.storybook --url http://localhost:6006",
    "test-storybook:coverage": "test-storybook --config-dir libs/ui/.storybook --url http://localhost:6006 --coverage --coverageDirectory coverage/storybook",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST \"http-server dist/storybook/ui --port 6006 --silent\" \"wait-on http://127.0.0.1:6006/iframe.html && test-storybook --config-dir libs/ui/.storybook --url http://127.0.0.1:6006 --coverage --coverageDirectory coverage/storybook\"",
    "test-storybook:nav": "node tools/scripts/storybook-nav-smoke.mjs",
    "chromatic": "chromatic --exit-zero-on-changes",
    "generate-index": "tsx tools/scripts/generate-index.ts",
    "docs:check": "node tools/scripts/check-docs-ssot.mjs",
    "contracts:check": "tsx tools/scripts/check-metadata-props.ts",
    "pds:component": "tsx tools/generators/sds-component/index.ts",
    "tokens:resolve": "node tools/tokens/resolve-dtcg.mjs",
    "tokens:audit": "tsx tools/tokens/audit-drift.mjs",
    "tokens:validate-preset": "tsx tools/tokens/validate-preset.mjs",
    "tokens:check-prefix": "node tools/tokens/check-prefix.mjs",
    "tokens:build": "node tools/tokens/build.mjs",
    "tokens:report": "node tools/tokens/report.mjs",
    "tokens:notify-figma": "node tools/tokens/notify-figma.mjs",
    "tokens:pull-figma": "node tools/tokens/pull-figma.mjs",
    "tokens:propose": "node tools/tokens/propose-to-figma.mjs",
    "tokens:propose:test": "node --test tools/tokens/propose-to-figma.spec.mjs",
    "tokens:apply": "node tools/tokens/apply-to-figma.mjs",
    "tokens:lint": "node tools/tokens/lint-usage.mjs",
    "figma-plugin:build": "node tools/figma-plugin/build.mjs",
    "figma-plugin:watch": "node tools/figma-plugin/build.mjs --watch",
    "figma-plugin:typecheck": "tsc -p tools/figma-plugin/tsconfig.json --noEmit && tsc -p tools/figma-plugin/tsconfig.ui.json --noEmit",
    "figma-plugin:test": "node --import tsx --test tools/figma-plugin/src/*.spec.ts",
    "pack:libs": "node tools/packaging/pack.mjs",
    "pack:smoke": "node tools/packaging/smoke-test.mjs",
    "storybook:packed": "node tools/packaging/storybook-packed.mjs",
    "build-storybook:packed": "node tools/packaging/storybook-packed.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm run changelog:build",
    "release": "changeset publish"
  },
  "dependencies": {
    "@angular/animations": "^21.2.16",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.16",
    "@angular/compiler": "^21.2.16",
    "@angular/core": "^21.2.16",
    "@angular/forms": "^21.2.16",
    "@angular/platform-browser": "^21.2.16",
    "@angular/router": "^21.2.16",
    "@primeuix/themes": "^2.0.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.5.1",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.4",
    "@angular-devkit/build-angular": "^21.2.14",
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.16",
    "@changesets/cli": "^2.29.8",
    "@chromatic-com/storybook": "^5.3.1",
    "@figma/plugin-typings": "^1.138.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@types/jasmine": "^6.0.0",
    "axe-playwright": "^2.2.2",
    "chromatic": "^18.7.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "http-server": "^14.1.1",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^21.2.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "remark-gfm": "^4.0.1",
    "sass": "^1.93.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^4.4.0",
    "stylelint": "^17.15.0",
    "ts-node": "10.9.1",
    "tsx": "^4.22.1",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vite-tsconfig-paths": "^6.0.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "webpack": "5.106.2"
  }
}
