{
  "compilerOptions": {
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "paths": {
      "@solidaris/contracts": [
        ".ai/contracts/schema/index.ts"
      ],
      "@solidaris-danielbodigil/pds-plectrum": [
        "libs/plectrum/src/index.ts"
      ],
      "@solidaris-danielbodigil/pds-styles": [
        "libs/styles/src/main.scss"
      ],
      "@solidaris-danielbodigil/pds-ui": [
        "libs/ui/src/index.ts"
      ],
      "@solidaris-danielbodigil/pds-ui/patterns/ishare": [
        "libs/ui/src/patterns-ishare-api.ts"
      ]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node10"
    }
  }
}
